{
  "name": "opentraffic-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "video": "remotion render remotion/index.ts Demo public/media/demo.mp4 --codec=h264 --crf=26 && remotion still remotion/index.ts Demo public/media/demo-poster.jpg --frame=560 --image-format=jpeg --jpeg-quality=85",
    "video:gif": "remotion render remotion/index.ts Demo ../docs/images/demo.gif --codec=gif --scale=0.4584 --every-nth-frame=3 --number-of-gif-loops=0",
    "studio": "remotion studio remotion/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/dm-serif-text": "^5.3.0",
    "@remotion/cli": "^4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.534",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
