// opentraffic.dev: the built site (npm run build) served as a static Cloudflare Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentraffic-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "opentraffic.dev", "custom_domain": true },
    { "pattern": "www.opentraffic.dev", "custom_domain": true }
  ]
}
