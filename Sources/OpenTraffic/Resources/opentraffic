#!/bin/sh
# opentraffic — OpenTraffic from the terminal. Settings → General links this file into your PATH; it
# runs the real program next to the app, Contents/MacOS/opentraffic-cli. `opentraffic help` for more.
self=$(/bin/realpath "$0") || exit 3
exec "$(/usr/bin/dirname "$self")/../MacOS/opentraffic-cli" "$@"
